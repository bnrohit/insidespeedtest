# Requires NGINX stable >=1.30.6 or mainline >=1.31.7.\n# Run: sudo bash deploy/security-preflight.sh\n# Internal-only reverse proxy: ensure GMCS internal DNS and firewall access to 443.
# Replace placeholder hostname/cert paths. Keep backend 8080 on LOOPBACK ONLY.
limit_req_zone $binary_remote_addr zone=gmcs_session:10m rate=4r/m;
limit_conn_zone $binary_remote_addr zone=gmcs_conn:10m;
server {
    listen 443 ssl;
    server_name speedtest.example.edu;
    ssl_certificate /etc/ssl/gmcs/fullchain.pem;
    ssl_certificate_key /etc/ssl/gmcs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 9m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Firewall / VPN / GMCS ACL must restrict client reachability.
    location / {
        limit_conn gmcs_conn 10;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
    location = /api/session {
        limit_req zone=gmcs_session burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Strongly recommended: restrict /admin and /api/admin/ using firewall or
    # Nginx allow/deny entries for VERIFIED NOC management addresses.
}
