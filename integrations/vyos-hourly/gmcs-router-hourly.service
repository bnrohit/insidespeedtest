[Unit]
Description=GMCS router hourly capped WAN-to-NOC performance sampling
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/gmcs-router-report/morning_report.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/gmcs-router-hourly/run_hourly.py
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gmcs-router-report /var/lib/gmcs-router-hourly /var/lib/docker /home/rohith/insidespeedtest
# Docker volume database may reside under /var/lib/docker.
