[Unit]
Description=Verified school Linux GMCS HTTPS speed measurement
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gmcs-speedtest
Group=gmcs-speedtest
ExecStart=/usr/bin/python3 /opt/gmcs-speedtest-direct/collect.py --config /etc/gmcs-speedtest/direct.json --cache /var/lib/gmcs-speedtest-direct/latest.json --agent-script /opt/gmcs-speedtest-direct/school_agent.py
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gmcs-speedtest-direct
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

